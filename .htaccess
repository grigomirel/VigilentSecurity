RewriteEngine On

# Retire URL spam exposed by the compromised legacy sitemaps.
RewriteCond %{QUERY_STRING} ^p=\d+$ [NC]
RewriteRule ^ - [G,L]
RewriteRule ^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+\.ever$ - [G,L,NC]

# The Romanian homepage is canonical at the domain root.
RewriteCond %{THE_REQUEST} \s/+acasa\.html(?:[?\s]) [NC]
RewriteRule ^acasa\.html$ / [R=301,L]

# Genuine legacy company pages with a clear modern equivalent.
RewriteRule ^(?:despre-noi|identitate|misiune-viziune-scop-valoare|codul-deontologic)/?$ /despre-noi.html [R=301,L,NC]
RewriteRule ^(?:licente-si-autorizatii|licente-de-functionare|certificari-de-calitate|reglementari-licente)/?$ /despre-noi.html#certificari [R=301,NE,L,NC]
RewriteRule ^comercializare-si-instalare-sisteme-de-alarma/?$ /sisteme-de-alarma.html [R=301,L,NC]
RewriteRule ^serviciul-de-monitorizare-si-interventie-rapida/?$ /monitorizare.html [R=301,L,NC]
RewriteRule ^serviciul-de-paza-umana/?$ /paza-umana.html [R=301,L,NC]
RewriteRule ^serviciul-de-securizare-evenimente/?$ /securitate-evenimente.html [R=301,L,NC]
RewriteRule ^serviciul-de-consultanta-de-securitate/?$ /plan-securitate.html [R=301,L,NC]
RewriteRule ^parcul-auto-moto/?$ /grupuri-de-interventie.html [R=301,L,NC]
RewriteRule ^portofoliu-2/?$ /despre-noi.html [R=301,L,NC]
RewriteRule ^serviciul-de-paza-a-transporturilor-de-bunuri-si-valori/?$ /transport-valori.html [R=301,L,NC]
RewriteRule ^serviciul-de-garda-de-corp/?$ /bodyguard.html [R=301,L,NC]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.emailjs.com; form-action 'self'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:png|jpe?g|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
